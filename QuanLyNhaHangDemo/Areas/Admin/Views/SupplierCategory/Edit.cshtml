@model QuanLyNhaHangDemo.Models.SupplierCategoryModel

@{
    ViewData["Title"] = "Sửa danh mục nhà cung cấp";
}

<h2>Sửa danh mục nhà cung cấp</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="SupplierCategoryId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="form-group mb-3">
        <label asp-for="Name">Tên danh mục</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description">Mô tả</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-group mb-3">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
