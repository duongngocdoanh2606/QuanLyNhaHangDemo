@{
    var c = ViewContext.RouteData.Values["controller"]?.ToString();
    var a = ViewContext.RouteData.Values["action"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/admin-layout.css" />
    <link rel="stylesheet" href="~/css/admin-sidebar.css" />
    <link rel="stylesheet" href="~/css/admin-responsive.css" />
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a class="logo" href="#">
                <i class="fas fa-tachometer-alt"></i> Admin
            </a>
        </div>

        <div class="sidebar-menu">

            <div class="menu-title">Main</div>

            <a class="nav-link @(c == "Home" ? "active" : "")"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <i class="fas fa-home"></i> Home
            </a>

            <a class="nav-link @(c == "Product" ? "active" : "")"
               asp-controller="Product" asp-action="Index">
                <i class="fas fa-box"></i> Products
            </a>

            <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse"
               href="#restaurantMenu"
               role="button"
               aria-expanded="false">

                <span>
                    <i class="fas fa-utensils"></i> Restaurant
                </span>
                <i class="fas fa-chevron-down"></i>
            </a>

            <div class="collapse @(area == "Admin" && (c == "TableAdmin" || c == "Kitchen" || c == "Warehouse") ? "show" : "")"
                 id="restaurantMenu">

                <a class="nav-link ms-4 @(c == "TableAdmin" ? "active" : "")"
                   asp-area="Admin" asp-controller="TableAdmin" asp-action="Index">
                    <i class="fas fa-chair"></i> Tables
                </a>

                <a class="nav-link ms-4 @(c == "Kitchen" ? "active" : "")"
                   asp-area="Admin" asp-controller="Kitchen" asp-action="Index">
                    <i class="fas fa-utensils"></i> Kitchen
                </a>

                <a class="nav-link ms-4 @(area == "Admin" && c == "Warehouse" ? "active" : "")"
                   asp-area="Admin" asp-controller="Warehouse" asp-action="Index">
                    <i class="fas fa-warehouse"></i> Warehouse
                </a>
            </div>

            <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse"
               href="#ManagerUser"
               role="button"
               aria-expanded="false">

                <span>
                    <i class="fas fa-user"></i> User
                </span>
                <i class="fas fa-chevron-down"></i>
            </a>

            <div class="collapse @(area == "Admin" && (c == "User" || c == "Role" || c == "Supplier" || c == "Brand") ? "show" : "")"
                 id="ManagerUser">

                <a class="nav-link ms-4 @(area == "Admin" && c == "Role" ? "active" : "")"
                   asp-area="Admin" asp-controller="Role" asp-action="Index">
                    <i class="fas fa-id-badge"></i> Role
                </a>

                <a class="nav-link ms-4 @(area == "Admin" && c == "User" ? "active" : "")"
                   asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-users-cog"></i> User
                </a>

                <a class="nav-link ms-4 @(area == "Admin" && c == "Supplier" ? "active" : "")"
                   asp-area="Admin" asp-controller="Supplier" asp-action="Index">
                    <i class="fas fa-handshake"></i> Supplier
                </a>

            </div>



            <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse"
               href="#Receipt"
               role="button"
               aria-expanded="false">

                <span>
                    <i class="fas fa-file-invoice"></i> Receipt
                </span>
                <i class="fas fa-chevron-down"></i>
            </a>

            <div class="collapse @(area == "Admin" && (c == "Order" || c == "Dashboard" || c == "ReservationAdmin") ? "show" : "")"
                 id="Receipt">

                <a class="nav-link ms-4 @(area == "Admin" && c == "Order" ? "active" : "")"
                   asp-area="Admin" asp-controller="Order" asp-action="Index">
                    <i class="fas fa-receipt"></i> Order
                </a>

                <a class="nav-link ms-4 @(c == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-chart-bar"></i> Dashboard
                </a>

                <a class="nav-link ms-4 @(area == "Admin" && c == "ReservationAdmin" ? "active" : "")"
                   asp-area="Admin" asp-controller="ReservationAdmin" asp-action="Index">
                    <i class="fas fa-clipboard-list"></i> Reservations
                </a>
            </div>
            <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse"
               href="#Other"
               role="button"
               aria-expanded="false">

                <span>
                    <i class="fas fa-exclamation-circle"></i> Other
                </span>
                <i class="fas fa-chevron-down"></i>
            </a>

            <div class="collapse @(area == "Admin" && (c == "Shipping" || c == "Slider" || c == "Discount" || c == "Category") ? "show" : "")"
                 id="Other">

                <a class="nav-link ms-4 @(area == "Admin" && c == "Shipping" ? "active" : "")"
                   asp-area="Admin" asp-controller="Shipping" asp-action="Index">
                    <i class="fas fa-truck"></i> Shipping
                </a>

                <a class="nav-link ms-4 @(area == "Admin" && c == "Discount" ? "active" : "")"
                   asp-area="Admin" asp-controller="Coupon" asp-action="Index">
                    <i class="fas fa-ticket-alt"></i> Discount
                </a>

                <a class="nav-link ms-4 @(c == "Category" ? "active" : "")"
                   asp-controller="Category" asp-action="Index">
                    <i class="fas fa-tags"></i> Categories
                </a>
            </div>

        </div>
    </aside>

    <!-- MAIN -->
    <main class="main-content">
        <div class="content-wrapper">

            <header class="header">
                <div class="d-flex align-items-center gap-2">
                    <button class="sidebar-toggle" id="toggleSidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="page-title">
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-user"></i> Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item">Profile</a></li>
                        <li><a class="dropdown-item">Logout</a></li>
                    </ul>
                </div>
            </header>

            <div class="card">
                <div class="card-body">
                    @RenderBody()
                </div>
            </div>

        </div>
    </main>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        document.getElementById("toggleSidebar")?.addEventListener("click", () => {
            document.querySelector(".sidebar").classList.toggle("show");
        });
    </script>
    <script>
        $(function () {
            var message = '@TempData["success"]';
            if (message != '')
                Swal.fire(message);
        });
    </script>

    @RenderSection("Scripts", false)
</body>
</html>
