@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-3">
        <label class="form-label fw-bold">Khoảng thời gian</label>
        <select id="filterType" class="form-select">
            <option value="all">Tất cả thời gian</option>
            <option value="week">7 ngày gần nhất</option>
            <option value="month">Tháng này</option>
            <option value="year">Năm nay</option>
            <option value="custom">Tùy chọn ngày</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Từ ngày</label>
        <input type="date" id="fromDate" class="form-control" disabled />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Đến ngày</label>
        <input type="date" id="toDate" class="form-control" disabled />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button id="btnFilter" class="btn btn-primary w-100">
            <i class="fas fa-filter me-2"></i>Áp dụng bộ lọc
        </button>
    </div>
</div>

<hr />

<div class="row mb-4 text-center">
    <div class="col-md-6 mb-3 mb-md-0">
        <div class="card bg-light p-4 border-primary shadow-sm">
            <h5 class="text-muted text-uppercase small fw-bold">Tổng doanh thu (Total Amount)</h5>
            <h2 id="totalRevenue" class="text-primary fw-bold mt-2">0 đ</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-light p-4 border-success shadow-sm">
            <h5 class="text-muted text-uppercase small fw-bold">Tổng lợi nhuận thực tế</h5>
            <h2 id="totalProfit" class="text-success fw-bold mt-2">0 đ</h2>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card p-4 shadow-sm">
            <h4 class="card-title mb-4 fw-bold text-secondary">
                <i class="fas fa-chart-area me-2"></i>Xu hướng doanh thu & Lợi nhuận
            </h4>
            <div style="position: relative; height:420px; width:100%">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let salesChartInstance = null;

        // Hàm định dạng tiền tệ VNĐ trực quan
        function formatMoney(value) {
            if (value == null) value = 0;
            return value.toLocaleString('vi-VN') + ' đ';
        }

        // Bật/tắt các ô nhập ngày dựa theo lựa chọn bộ lọc
        $('#filterType').on('change', function () {
            if ($(this).val() === 'custom') {
                $('#fromDate, #toDate').prop('disabled', false);
            } else {
                $('#fromDate, #toDate').prop('disabled', true).val('');
            }
        });

        // Hàm chính Ajax kết nối tới DashboardController
        function loadDashboardData(type, from, to) {
            $.post("/Admin/Dashboard/GetChartData", {
                type: type,
                startDate: from,
                endDate: to
            })
            .done(function (response) {
                if (!response) return;

                // 1. Gán số liệu tổng quan vào các thẻ đầu trang
                if (response.summary) {
                    $('#totalRevenue').text(formatMoney(response.summary.totalRevenue));
                    $('#totalProfit').text(formatMoney(response.summary.totalProfit));
                }

                // 2. Phân tách mảng chartData để đưa vào Chart.js
                var chartData = response.chartData || [];
                var labels = chartData.map(x => x.date);
                var revenueData = chartData.map(x => x.revenue); // Map chuẩn theo thuộc tính 'revenue' mới
                var profitData = chartData.map(x => x.profit);

                // Hủy instance cũ nếu có để tránh lỗi hiển thị đè nét khi render lại
                if (salesChartInstance) {
                    salesChartInstance.destroy();
                }

                // Vẽ biểu đồ dạng đường (Line Chart) vùng phủ
                var ctx = document.getElementById("salesChart").getContext("2d");
                salesChartInstance = new Chart(ctx, {
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Doanh thu (Hóa đơn)',
                                data: revenueData,
                                borderColor: '#3c8dbc',
                                backgroundColor: 'rgba(60, 141, 188, 0.1)',
                                borderWidth: 2.5,
                                tension: 0.2,
                                fill: true
                            },
                            {
                                type: 'line',
                                label: 'Lợi nhuận ròng',
                                data: profitData,
                                borderColor: '#00a65a',
                                backgroundColor: 'rgba(0, 166, 90, 0.1)',
                                borderWidth: 2.5,
                                tension: 0.2,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return formatMoney(value); }
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + formatMoney(context.raw);
                                    }
                                }
                            }
                        }
                    }
                });
            })
            .fail(function () {
                console.error("Lỗi hệ thống không lấy được dữ liệu thống kê!");
            });
        }

        // Click áp dụng bộ lọc
        $('#btnFilter').on('click', function () {
            var type = $('#filterType').val();
            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            if (type === 'custom') {
                if (!from || !to) {
                    alert('Vui lòng nhập đầy đủ mốc từ ngày và đến ngày!');
                    return;
                }
                if (from > to) {
                    alert('Mốc ngày bắt đầu không được vượt quá ngày kết thúc!');
                    return;
                }
            }
            loadDashboardData(type, from, to);
        });

        // Tự động tải toàn bộ dữ liệu ngay khi khởi chạy trang
        $(document).ready(function () {
            loadDashboardData('all', null, null);
        });
    </script>
}