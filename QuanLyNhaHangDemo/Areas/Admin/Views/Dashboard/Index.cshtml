@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-3">
        <label class="form-label fw-bold">Khoảng thời gian</label>
        <select id="filterType" class="form-select">
            <option value="all">Tất cả thời gian</option>
            <option value="week">7 ngày gần nhất</option>
            <option value="month">Tháng này</option>
            <option value="year">Năm nay</option>
            <option value="custom">Tùy chọn ngày</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Từ ngày</label>
        <input type="date" id="fromDate" class="form-control" disabled />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Đến ngày</label>
        <input type="date" id="toDate" class="form-control" disabled />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button id="btnFilter" class="btn btn-primary w-100">
            <i class="fas fa-filter me-2"></i>Áp dụng bộ lọc
        </button>
    </div>
</div>

<hr />

<!-- Hàng 1: Doanh thu -->
<div class="row mb-3 text-center g-3">
    <div class="col-md-3">
        <div class="card bg-light p-3 border-secondary shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Doanh thu món gốc (SubTotal)</h6>
            <h4 id="totalSubRevenue" class="text-secondary fw-bold mt-1">0 đ</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-light p-3 border-warning shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Thuế VAT</h6>
            <h4 id="totalVAT" class="text-warning fw-bold mt-1">0 đ</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-light p-3 border-warning shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Phí dịch vụ</h6>
            <h4 id="totalService" class="text-warning fw-bold mt-1">0 đ</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-light p-3 border-primary shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Doanh thu thực tế (Grand Total)</h6>
            <h4 id="totalRevenue" class="text-primary fw-bold mt-1">0 đ</h4>
        </div>
    </div>
</div>

<!-- Hàng 2: Chi phí & Lợi nhuận -->
<div class="row mb-4 text-center g-3">
    <div class="col-md-4">
        <div class="card bg-light p-3 border-danger shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Chi phí NVL (OUT_SALE)</h6>
            <h4 id="totalSaleCost" class="text-danger fw-bold mt-1">0 đ</h4>
        </div>
    </div>
    <!-- Ẩn chi phí làm lại
    <div class="col-md-3">
        <div class="card bg-light p-3 h-100 shadow-sm" style="border-color:#fd7e14 !important; border: 1px solid;">
            <h6 class="text-muted text-uppercase small fw-bold">Chi phí làm lại (Remake)</h6>
            <h4 id="totalRemakeCost" class="fw-bold mt-1" style="color:#fd7e14;">0 đ</h4>
        </div>
    </div>
    -->
    <div class="col-md-4">
        <div class="card bg-light p-3 border-danger shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Tổng giảm giá (Coupon)</h6>
            <h4 id="totalDiscount" class="text-danger fw-bold mt-1">0 đ</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-light p-3 border-success shadow-sm h-100">
            <h6 class="text-muted text-uppercase small fw-bold">Lợi nhuận thực tế</h6>
            <h4 id="totalProfit" class="text-success fw-bold mt-1">0 đ</h4>
        </div>
    </div>
</div>

<!-- Hàng 3: Thống kê mở rộng -->
<div class="row mb-4">
    <!-- Cột bên trái: Thống kê món ăn -->
    <div class="col-md-8">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="fas fa-arrow-trend-up me-2"></i>Top 5 Món Bán Chạy</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Tên món</th>
                                    <th class="text-end">Đã bán</th>
                                </tr>
                            </thead>
                            <tbody id="topSellingBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="fas fa-arrow-trend-down me-2"></i>Top 5 Món Bán Ít Nhất</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Tên món</th>
                                    <th class="text-end">Đã bán</th>
                                </tr>
                            </thead>
                            <tbody id="leastSellingBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Cột bên phải: Giờ cao điểm -->
    <div class="col-md-4">
        <div class="card bg-info text-white shadow-sm h-100 text-center">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <h6 class="text-uppercase fw-bold mb-3"><i class="fas fa-clock me-2"></i>Giờ Cao Điểm</h6>
                <div class="display-4 fw-bold" id="peakHourText">--:--</div>
                <p class="mt-2 mb-0" id="peakHourOrders">0 đơn hàng</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card p-4 shadow-sm">
            <h4 class="card-title mb-4 fw-bold text-secondary">
                <i class="fas fa-chart-area me-2"></i>Xu hướng doanh thu &amp; Lợi nhuận
            </h4>
            <div style="position: relative; height:420px; width:100%">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let salesChartInstance = null;

        function formatMoney(value) {
            if (value == null) value = 0;
            return value.toLocaleString('vi-VN') + ' đ';
        }

        $('#filterType').on('change', function () {
            if ($(this).val() === 'custom') {
                $('#fromDate, #toDate').prop('disabled', false);
            } else {
                $('#fromDate, #toDate').prop('disabled', true).val('');
            }
        });

        function loadDashboardData(type, from, to) {
            $.post("/Admin/Dashboard/GetChartData", {
                type: type,
                startDate: from,
                endDate: to
            })
            .done(function (response) {
                if (!response) return;

                // Gán số liệu tổng quan vào các thẻ đầu trang
                if (response.summary) {
                    var s = response.summary;
                    $('#totalSubRevenue').text(formatMoney(s.totalSubRevenue));
                    $('#totalVAT').text('+' + formatMoney(s.totalVAT));
                    $('#totalService').text('+' + formatMoney(s.totalService));
                    $('#totalDiscount').text('-' + formatMoney(s.totalDiscount));
                    $('#totalRevenue').text(formatMoney(s.totalRevenue));
                    $('#totalSaleCost').text(formatMoney(s.totalSaleCost));
                    $('#totalRemakeCost').text(formatMoney(s.totalRemakeCost));
                    $('#totalProfit').text(formatMoney(s.totalProfit));
                }

                if (response.insights) {
                    var insights = response.insights;
                    
                    // Top bán chạy
                    var topHtml = '';
                    if (insights.topSelling && insights.topSelling.length > 0) {
                        insights.topSelling.forEach(item => {
                            topHtml += `<tr><td>${item.productName}</td><td class="text-end fw-bold">${item.quantity}</td></tr>`;
                        });
                    } else {
                        topHtml = '<tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu</td></tr>';
                    }
                    $('#topSellingBody').html(topHtml);

                    // Top bán ế
                    var leastHtml = '';
                    if (insights.leastSelling && insights.leastSelling.length > 0) {
                        insights.leastSelling.forEach(item => {
                            leastHtml += `<tr><td>${item.productName}</td><td class="text-end fw-bold text-danger">${item.quantity}</td></tr>`;
                        });
                    } else {
                        leastHtml = '<tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu</td></tr>';
                    }
                    $('#leastSellingBody').html(leastHtml);

                    // Khung giờ cao điểm
                    if (insights.peakHour) {
                        $('#peakHourText').text(`${insights.peakHour.hour}h - ${insights.peakHour.hour + 1}h`);
                        $('#peakHourOrders').text(`${insights.peakHour.orderCount} đơn hàng`);
                    } else {
                        $('#peakHourText').text('--:--');
                        $('#peakHourOrders').text('0 đơn hàng');
                    }
                }

                var chartData = response.chartData || [];
                var labels = chartData.map(x => x.date);
                var revenueData = chartData.map(x => x.revenue);
                var profitData = chartData.map(x => x.profit);

                if (salesChartInstance) {
                    salesChartInstance.destroy();
                }

                var ctx = document.getElementById("salesChart").getContext("2d");
                salesChartInstance = new Chart(ctx, {
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Doanh thu thực tế (GrandTotal)',
                                data: revenueData,
                                borderColor: '#3c8dbc',
                                backgroundColor: 'rgba(60, 141, 188, 0.1)',
                                borderWidth: 2.5,
                                tension: 0.2,
                                fill: true
                            },
                            {
                                type: 'line',
                                label: 'Lợi nhuận ròng (sau chi phí NVL & làm lại)',
                                data: profitData,
                                borderColor: '#00a65a',
                                backgroundColor: 'rgba(0, 166, 90, 0.1)',
                                borderWidth: 2.5,
                                tension: 0.2,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return formatMoney(value); }
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + formatMoney(context.raw);
                                    }
                                }
                            }
                        }
                    }
                });
            })
            .fail(function () {
                console.error("Lỗi hệ thống không lấy được dữ liệu thống kê!");
            });
        }

        $('#btnFilter').on('click', function () {
            var type = $('#filterType').val();
            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            if (type === 'custom') {
                if (!from || !to) {
                    alert('Vui lòng nhập đầy đủ mốc từ ngày và đến ngày!');
                    return;
                }
                if (from > to) {
                    alert('Mốc ngày bắt đầu không được vượt quá ngày kết thúc!');
                    return;
                }
            }
            loadDashboardData(type, from, to);
        });

        // ─── SignalR: Nhận thông báo đơn mới, thanh toán và làm lại ───
        if (typeof signalRConnection !== 'undefined' && signalRConnection) {
            signalRConnection.on("NewOrderCreated", function (data) {
                showDashboardAlert(
                    'info',
                    '<i class="fas fa-receipt me-2"></i>' +
                    '<strong>Đơn mới!</strong> ' + data.message,
                    8000
                );
            });

            signalRConnection.on("OrderPaid", function (data) {
                showDashboardAlert(
                    'success',
                    '<i class="fas fa-check-circle me-2"></i>' +
                    '<strong>Thanh toán!</strong> ' + data.message,
                    8000
                );
            });

            signalRConnection.on("DishRemade", function (data) {
                showDashboardAlert(
                    'danger',
                    '<i class="fas fa-exclamation-triangle me-2"></i>' +
                    '<strong>Làm lại món!</strong> ' + data.message,
                    12000
                );
            });
        }

        function showDashboardAlert(type, html, duration) {
            var colors = {
                info:    { bg: '#d1ecf1', border: '#bee5eb', text: '#0c5460' },
                warning: { bg: '#fff3cd', border: '#ffeeba', text: '#856404' },
                success: { bg: '#d4edda', border: '#c3e6cb', text: '#155724' },
                danger:  { bg: '#f8d7da', border: '#f5c6cb', text: '#721c24' }
            };
            var c = colors[type] || colors['info'];

            var $alert = $('<div>')
                .css({
                    position: 'fixed', top: '80px', right: '20px', zIndex: 9999,
                    minWidth: '340px', maxWidth: '460px', padding: '14px 18px',
                    borderRadius: '8px', boxShadow: '0 4px 16px rgba(0,0,0,.15)',
                    background: c.bg, border: '1px solid ' + c.border, color: c.text,
                    fontSize: '0.92rem', opacity: 0
                })
                .html(html + ' <button type="button" style="float:right;background:none;border:none;font-size:1.1rem;cursor:pointer;color:' + c.text + '">×</button>')
                .appendTo('body')
                .animate({ opacity: 1 }, 300);

            $alert.find('button').on('click', function () { $alert.fadeOut(200, function () { $(this).remove(); }); });

            if (duration) {
                setTimeout(function () { $alert.fadeOut(400, function () { $(this).remove(); }); }, duration);
            }
        }

        $(document).ready(function () {
            loadDashboardData('all', null, null);
        });
    </script>
}