
@model List<KitchenModel>

@{
    // Lấy id bếp được chọn từ controller (nếu không có, fallback về bếp đầu)
    int selectedKitchenId = ViewBag.SelectedKitchenId != null ? (int)ViewBag.SelectedKitchenId : (Model.FirstOrDefault()?.Id ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-3">Khu bếp</h3>
    <a asp-action="Create" class="btn btn-primary">
        Add Kitchen
    </a>
</div>
<!-- TAB HEADER -->
<ul class="nav nav-tabs" id="kitchenTabs" role="tablist">
    @for (int i = 0; i < Model.Count; i++)
    {
        var kitchen = Model[i];
        <li class="nav-item" role="presentation">
            <button class="nav-link @(kitchen.Id == selectedKitchenId ? "active" : "")"
                    id="tab-@kitchen.Id"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-@kitchen.Id"
                    type="button"
                    role="tabpanel"
                    aria-selected="@(kitchen.Id == selectedKitchenId ? "true" : "false")">
                @kitchen.Name
            </button>
        </li>
    }
</ul>

<!-- TAB CONTENT -->
<div class="tab-content border border-top-0 p-3">
    @for (int i = 0; i < Model.Count; i++)
    {
        var kitchen = Model[i];
        <div class="tab-pane fade @(kitchen.Id == selectedKitchenId ? "show active" : "")"
             id="pane-@kitchen.Id"
             role="tabpanel">

            <!-- CRUD -->
            <div class="d-flex justify-content-end mb-2">
                <a asp-action="Edit" asp-route-id="@kitchen.Id"
                   class="btn btn-sm btn-outline-warning me-1">
                    ✏️ Sửa
                </a>
                <a asp-action="Delete"
                   asp-route-id="@kitchen.Id"
                   class="btn btn-sm btn-outline-danger"
                   onclick="return confirm('Xóa bếp này?')">
                    🗑 Xóa
                </a>
            </div>

            <!-- MÀN HÌNH BẾP -->
            @await Component.InvokeAsync(
            "KitchenScreen",
                new { kitchenId = kitchen.Id }
                )
    </div>
        }
</div>