@model IEnumerable<QuanLyNhaHangDemo.Models.CouponModel>

@{
    ViewData["Title"] = "Quản lý mã giảm giá";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách mã giảm giá</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Tạo mã mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-bordered table-striped table-hover shadow-sm text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mã Coupon</th>
                <th>Số tiền giảm</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Chưa có mã giảm giá nào được tạo.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong class="text-danger">@item.Code</strong></td>
                        <td>@item.DiscountAmount.ToString("#,##0") đ</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Đang kích hoạt</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đang khóa</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>