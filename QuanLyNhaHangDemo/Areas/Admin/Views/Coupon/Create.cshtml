@model CouponModel

<form method="post">
    <div class="form-group">
        <label>Code</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Discount Type</label>
        <select asp-for="DiscountType" class="form-control">
            <option value="Percentage">%</option>
            <option value="FixedAmount">Tiền</option>
        </select>
    </div>

    <div class="form-group">
        <label>Discount Value</label>
        <input asp-for="DiscountValue" class="form-control" />
    </div>

    <div class="form-group" id="maxDiscountGroup">
        <label>Max Discount Amount</label>
        <input asp-for="MaxDiscountAmount" class="form-control" />
    </div>

    <div class="form-group">
        <label>Min Order Amount</label>
        <input asp-for="MinOrderAmount" class="form-control" />
    </div>

    <div class="form-group">
        <label>Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Usage Limit</label>
        <input asp-for="UsageLimit" class="form-control" />
    </div>

    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}