@model IEnumerable<QuanLyNhaHangDemo.Models.ModifierGroupModel>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Danh sách Nhóm Tùy Chọn</h4>
        <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tên Nhóm</th>
                    <th>Loại Nhóm</th>
                    <th>Bắt buộc</th>
                    <th>Chọn tối đa</th>
                    <th>Số tùy chọn con</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>
                            @if (item.Type == "SIZE")
                            {
                                <span class="badge bg-info text-dark">Kích cỡ (SIZE)</span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white">Đồ kèm (TOPPING)</span>
                            }
                        </td>
                        <td>@(item.IsRequired ? "Có" : "Không")</td>
                        <td>@item.MaxSelect</td>
                        <td>@item.Modifiers?.Count</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Xóa nhóm này sẽ xóa tất cả tùy chọn bên trong. Bạn chắc chứ?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>