@model IEnumerable<CategoryModel>
@{
    ViewData["title"] = "Category Listed";

}
<a asp-area="Admin" asp-action="Create" asp-controller="Category">Add Category</a>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Category Name</th>
            <th scope="col">Category Description</th> 
            <th scope="col">Kitchen</th>
            <th scope="col">Category Status</th>
            <th scope="col">Chế độ bếp</th>
            <th scope="col">Action</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Kitchen.Name</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="text text-success">Hien Thi</span>
                    }
                    else
                    {
                        <span class="text text-erroe">An</span>
                    }
                </td>
                <td>
                    <input type="checkbox"
                           class="auto-fire-toggle"
                           data-id="@item.Id"
                           @(item.isAutoFire ? "checked" : "") />

                    <span class="status-label @(item.isAutoFire ? "text-success" : "text-muted")">
                        @(item.isAutoFire ? "Auto" : "Hold")
                    </span>
                </td>
                
                
                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Category" asp-route-Id="@item.Id">Edit</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Category" asp-route-Id="@item.Id">Delete</a>
                </td>
            </tr>
        }

        
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.auto-fire-toggle').change(function () {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                var label = $(this).closest('td').find('.status-label');

                $.ajax({
                    url: '@Url.Action("UpdateAutoFire", "Category", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        id: id,
                        status: isChecked
                    },
                    success: function (response) {
                        if (response.success) {
                            // Cập nhật nhãn chữ ngay lập tức
                            label.text(isChecked ? "Auto" : "Hold");
                            label.toggleClass('text-success text-muted');
                        } else {
                            alert("Lỗi khi cập nhật trạng thái!");
                        }
                    }
                });
            });
        });
    </script>
    }
