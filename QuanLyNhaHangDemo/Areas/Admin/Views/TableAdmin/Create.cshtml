@model TableModel

<h2>Thêm bàn</h2>

<form method="post">
    <div class="form-group">
        <label>Tên bàn</label>
        <input asp-for="TableName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Loại bàn</label>
        <input asp-for="Capacity" type="number" min="1" class="form-control" />
    </div>

    <button class="btn btn-success">Thêm</button>
</form>
