@model QuanLyNhaHangDemo.Models.TableModel

@{
    ViewData["Title"] = "Sửa thông tin bàn";
    // Lấy danh sách khu vực được truyền từ Controller qua ViewBag
    var zones = ViewBag.Zones as List<QuanLyNhaHangDemo.Models.ZoneModel> ?? new List<QuanLyNhaHangDemo.Models.ZoneModel>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Chỉnh sửa bàn: @Model.TableName
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="PosX" />
                        <input type="hidden" asp-for="PosY" />
                        <input type="hidden" asp-for="Width" />
                        <input type="hidden" asp-for="Height" />

                        <div class="mb-3">
                            <label asp-for="TableName" class="form-label fw-semibold">Tên bàn</label>
                            <input asp-for="TableName" class="form-control form-control-lg" placeholder="Ví dụ: Bàn số 10" />
                            <span asp-validation-for="TableName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacity" class="form-label fw-semibold">Sức chứa (Số ghế)</label>
                            <input asp-for="Capacity" type="number" min="1" class="form-control form-control-lg" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ZoneId" class="form-label fw-semibold">Khu vực / Tầng</label>
                            <select asp-for="ZoneId" class="form-select form-select-lg"
                                    asp-items="@(new SelectList(zones, "ZoneId", "ZoneName"))">
                                <option value="">-- Chọn khu vực --</option>
                            </select>
                            <span asp-validation-for="ZoneId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-semibold">Trạng thái bàn</label>
                            <select asp-for="Status" class="form-select form-select-lg"
                                    asp-items="Html.GetEnumSelectList<QuanLyNhaHangDemo.Models.TableStatus>()">
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="fas fa-save me-1"></i> Cập nhật bàn
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}