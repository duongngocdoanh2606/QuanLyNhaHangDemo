@model QuanLyNhaHangDemo.Models.InventoryTransactionModel
@{
    Layout = null; // No admin layout for printing
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu Nhập Kho - @Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: "Times New Roman", Times, serif; font-size: 14pt; background: #ccc; }
        .invoice-box {
            max-width: 800px; margin: 30px auto; padding: 40px;
            background: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.15);
        }
        .invoice-title { text-transform: uppercase; font-weight: bold; font-size: 24pt; text-align: center; margin-bottom: 5px; }
        .table-invoice th { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; }
        @@media print {
            body { background: #fff; margin: 0; padding: 0; }
            .invoice-box { box-shadow: none; margin: 0; padding: 20px; width: 100%; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <div class="d-flex justify-content-between mb-4">
            <div>
                <h4>NHÀ HÀNG DEMO</h4>
                <div>Địa chỉ: 123 Đường ABC, Quận X, TP.Y</div>
                <div>Điện thoại: 0123.456.789</div>
            </div>
            <div class="text-end">
                <div class="fw-bold">Số phiếu: NK-@Model.Id.ToString("D5")</div>
                <div>Ngày: @Model.DateCreated.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="invoice-title">PHIẾU NHẬP KHO</div>
        <div class="text-center mb-4 text-muted">(Bản lưu nội bộ)</div>

        <div class="mb-4">
            <table class="table table-borderless table-sm mb-0">
                <tr>
                    <td width="200"><strong>Nhà cung cấp:</strong></td>
                    <td>@(Model.Material?.Supplier?.SupplierName ?? "---")</td>
                </tr>
                <tr>
                    <td><strong>Ghi chú:</strong></td>
                    <td>@(string.IsNullOrEmpty(Model.Note) ? "---" : Model.Note)</td>
                </tr>
            </table>
        </div>

        <table class="table table-bordered table-invoice align-middle">
            <thead>
                <tr>
                    <th width="50" class="text-center">STT</th>
                    <th>Tên nguyên liệu</th>
                    <th class="text-center">ĐVT</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center">1</td>
                    <td>@Model.Material?.Name</td>
                    <td class="text-center">@Model.Material?.Unit</td>
                    <td class="text-center">@Model.Quantity.ToString("G29")</td>
                    <td class="text-end">@Model.UnitPrice.ToString("N0")</td>
                    <td class="text-end fw-bold">@Model.TotalPrice.ToString("N0")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end fs-5">TỔNG CỘNG:</th>
                    <th class="text-end fs-5">@Model.TotalPrice.ToString("N0") VNĐ</th>
                </tr>
            </tfoot>
        </table>

        <div class="row mt-5 text-center">
            <div class="col-4">
                <strong>Người lập phiếu</strong>
                <div class="text-muted small mt-1">(Ký, ghi rõ họ tên)</div>
                <div style="height: 100px;"></div>
            </div>
            <div class="col-4">
                <strong>Người giao hàng</strong>
                <div class="text-muted small mt-1">(Ký, ghi rõ họ tên)</div>
                <div style="height: 100px;"></div>
            </div>
            <div class="col-4">
                <strong>Thủ kho</strong>
                <div class="text-muted small mt-1">(Ký, ghi rõ họ tên)</div>
                <div style="height: 100px;"></div>
            </div>
        </div>

        <div class="text-center mt-4 no-print">
            <button onclick="window.print()" class="btn btn-primary px-4">
                <i class="fas fa-print me-2"></i> In phiếu
            </button>
            <button onclick="window.close()" class="btn btn-secondary px-4 ms-2">Đóng</button>
        </div>
    </div>
</body>
</html>
