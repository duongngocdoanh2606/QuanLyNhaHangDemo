@model InventoryTransactionModel
@{
    var material = ViewBag.Material as MaterialModel;
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h4 class="mb-0">Nhập kho nguyên liệu</h4>
</div>

<!-- Thông tin nguyên liệu -->
<div class="alert alert-success d-flex align-items-center gap-3 mb-4" role="alert">
    <i class="fas fa-box fa-2x text-success"></i>
    <div>
        <div class="fw-bold fs-5">@material?.Name</div>
        <div class="text-muted">
            Đơn vị: <strong>@material?.Unit</strong> &nbsp;|&nbsp;
            Tồn kho hiện tại: <strong class="text-success">@material?.CurrentQuantity</strong> @material?.Unit
        </div>
        <div class="text-muted small">Nhà cung cấp: @material?.Supplier?.SupplierName</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <i class="fas fa-arrow-circle-down me-2"></i> Thông tin nhập kho
    </div>
    <div class="card-body">
        <form asp-action="Import" method="post">
            <input type="hidden" asp-for="MaterialId" />
            <div asp-validation-summary="All" class="alert alert-danger" id="validationSummary"></div>

            <!-- Số lượng -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-sort-numeric-up me-1 text-secondary"></i>
                    Số lượng nhập <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="Quantity" type="text" asp-format="{0:0.###}"
                           class="form-control" required
                           placeholder="Ví dụ: 10 hoặc 5.5" />
                    <span class="input-group-text">@material?.Unit</span>
                </div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <!-- Đơn giá -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-dollar-sign me-1 text-secondary"></i>
                    Đơn giá (VNĐ)
                </label>
                <input asp-for="UnitPrice" type="text" asp-format="{0:0.###}"
                       class="form-control"
                       placeholder="Đơn giá nhập kho" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            <!-- Ghi chú -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <i class="fas fa-sticky-note me-1 text-secondary"></i>
                    Ghi chú
                </label>
                <input asp-for="Note" class="form-control"
                       placeholder="Ghi chú thêm (tùy chọn)" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    <i class="fas fa-check me-2"></i> Xác nhận nhập kho
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>
