@model QuanLyNhaHangDemo.Models.ViewModels.CreateMaterialViewModel

@{
    ViewData["Title"] = "Cập nhật nguyên liệu";
}

<div class="container mt-4">
    <div class="card shadow" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">📝 Chỉnh sửa thông tin nguyên liệu</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditMaterial" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Material.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên nguyên liệu</label>
                    <input asp-for="Material.Name" class="form-control" required />
                    <span asp-validation-for="Material.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Đơn vị tính</label>
                    <input asp-for="Material.Unit" class="form-control" placeholder="Ví dụ: kg, lít, hộp" required />
                    <span asp-validation-for="Material.Unit" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nhà cung cấp đối tác</label>
                    <select asp-for="Material.SupplierId"
                            asp-items="Model.Suppliers"
                            id="supplierDropdown"
                            class="form-select form-control">
                        <option value="">-- Chọn nhà cung cấp liên kết --</option>
                    </select>
                    <span asp-validation-for="Material.SupplierId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mức cảnh báo tồn kho tối thiểu</label>
                    <input asp-for="Material.ReorderLevel" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Material.ReorderLevel" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Material.ExpiryDate" class="form-label fw-bold">Ngày hết hạn</label>
                    <input asp-for="Material.ExpiryDate" class="form-control" type="date" />
                    <span asp-validation-for="Material.ExpiryDate" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-4">💾 Cập nhật ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/material-form.js"></script>
}