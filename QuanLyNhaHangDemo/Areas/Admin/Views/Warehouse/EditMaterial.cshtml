@model QuanLyNhaHangDemo.Models.ViewModels.CreateMaterialViewModel

<h2>Sửa nguyên liệu</h2>

<form asp-action="EditMaterial">
    <input type="hidden" asp-for="Material.Id" />

    <div class="mb-3">
        <label>Tên</label>
        <input asp-for="Material.Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Đơn vị</label>
        <input asp-for="Material.Unit" class="form-control" />
    </div>

    <select asp-for="Material.SupplierId"
            id="supplierDropdown">
        <option value=""></option>
        @foreach (var item in Model.Suppliers)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>

    <div class="mb-3">
        <label>Số lượng ban đầu</label>
        <input asp-for="InitialQuantity" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Giá nhập</label>
        <input asp-for="UnitPrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mức cảnh báo</label>
        <input asp-for="Material.ReorderLevel" class="form-control" />
    </div>

    <button class="btn btn-success">Cập nhật</button>
</form>
@section Scripts {
    <script src="~/js/material-form.js"></script>
}