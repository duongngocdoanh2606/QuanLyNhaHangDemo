@model IEnumerable<QuanLyNhaHangDemo.Models.InventoryTransactionModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Lịch sử nhập kho";
    var materials       = ViewBag.Materials as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedMat     = ViewBag.SelectedMaterial as int?;
    var from            = ViewBag.From as DateTime?;
    var to              = ViewBag.To as DateTime?;
    decimal totalCost   = ViewBag.TotalCost ?? 0;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h4 class="mb-0"><i class="fas fa-arrow-circle-down text-success me-2"></i>Lịch sử nhập kho</h4>
    </div>
    <a asp-action="ExportHistory" class="btn btn-warning btn-sm">
        <i class="fas fa-arrow-circle-up me-1"></i> Xem lịch sử xuất kho
    </a>
</div>

<!-- Bộ lọc -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="ImportHistory" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Nguyên liệu</label>
                <select name="materialId" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    @foreach (var m in materials)
                    {
                        <option value="@m.Value" selected="@(selectedMat?.ToString() == m.Value)">@m.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Từ ngày</label>
                <input type="date" name="from" class="form-control form-control-sm"
                       value="@(from?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Đến ngày</label>
                <input type="date" name="to" class="form-control form-control-sm"
                       value="@(to?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="fas fa-filter me-1"></i> Lọc
                </button>
                <a asp-action="ImportHistory" class="btn btn-outline-secondary btn-sm flex-fill">
                    <i class="fas fa-times me-1"></i> Xóa lọc
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Thẻ tổng chi phí -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-success shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="fas fa-coins text-success fa-lg"></i>
                </div>
                <div>
                    <div class="small text-muted">Tổng chi phí nhập kho</div>
                    <div class="fw-bold fs-5 text-success">@totalCost.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-primary shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="fas fa-list text-primary fa-lg"></i>
                </div>
                <div>
                    <div class="small text-muted">Số phiếu nhập</div>
                    <div class="fw-bold fs-5 text-primary">@Model.Count()</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center py-4">
        <i class="fas fa-inbox fa-2x mb-2 d-block text-muted"></i>
        Không có dữ liệu nhập kho phù hợp với bộ lọc.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-success">
                <tr>
                    <th width="40">#</th>
                    <th>Nguyên liệu</th>
                    <th>Nhà cung cấp</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                    <th>Ghi chú</th>
                    <th>Ngày nhập</th>
                    <th class="text-center" width="90">In HĐ</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@stt++</td>
                        <td>
                            <div class="fw-semibold">@item.Material?.Name</div>
                            <div class="small text-muted">Đơn vị: @item.Material?.Unit</div>
                        </td>
                        <td>@item.Material?.Supplier?.SupplierName</td>
                        <td class="text-center fw-semibold text-success">
                            +@item.Quantity <small class="text-muted">@item.Material?.Unit</small>
                        </td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                        <td class="text-end fw-bold text-success">@item.TotalPrice.ToString("N0") ₫</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <span class="badge bg-light text-dark border">@item.Note</span>
                            }
                        </td>
                        <td>
                            <div>@item.DateCreated.ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">@item.DateCreated.ToString("HH:mm")</div>
                        </td>
                        <td class="text-center">
                            <a asp-action="PrintImportInvoice" asp-route-id="@item.Id"
                               class="btn btn-outline-success btn-sm" target="_blank" title="In hóa đơn">
                                <i class="fas fa-print"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">Tổng cộng:</td>
                    <td class="text-end text-success">@totalCost.ToString("N0") ₫</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}