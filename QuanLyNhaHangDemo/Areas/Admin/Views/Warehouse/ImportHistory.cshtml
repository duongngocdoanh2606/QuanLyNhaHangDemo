@model IEnumerable<QuanLyNhaHangDemo.Models.InventoryTransactionModel>

<h2>Lịch sử nhập kho</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nguyên liệu</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
            <th>Ngày</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Material.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.TotalPrice</td>
                <td>@item.DateCreated</td>
            </tr>
        }
    </tbody>
</table>

<div class="alert alert-success">
    Tổng chi phí: <b>@ViewBag.TotalCost</b>
</div>