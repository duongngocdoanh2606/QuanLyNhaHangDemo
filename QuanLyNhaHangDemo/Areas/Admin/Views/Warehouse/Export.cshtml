@model QuanLyNhaHangDemo.Models.InventoryTransactionModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Xuất kho";
    var material  = ViewBag.Material as QuanLyNhaHangDemo.Models.MaterialModel;
    var suppliers = ViewBag.Suppliers as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h4 class="mb-0">Xuất kho nguyên liệu</h4>
</div>

<!-- Thông tin nguyên liệu -->
<div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">
    <i class="fas fa-box-open fa-2x text-warning"></i>
    <div>
        <div class="fw-bold fs-5">@material?.Name</div>
        <div class="text-muted">
            Đơn vị: <strong>@material?.Unit</strong> &nbsp;|&nbsp;
            Tồn kho hiện tại: <strong class="text-danger">@material?.CurrentQuantity</strong> @material?.Unit
        </div>
        <div class="text-muted small">Nhà cung cấp: @material?.Supplier?.SupplierName</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <i class="fas fa-sign-out-alt me-2"></i> Thông tin xuất kho
    </div>
    <div class="card-body">
        <form asp-action="Export" method="post">
            <input type="hidden" asp-for="MaterialId" />
        <div asp-validation-summary="All" class="text-danger"></div>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger d-none" id="validationSummary"></div>

            <!-- Lý do xuất -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-tag me-1 text-secondary"></i> Lý do xuất kho <span class="text-danger">*</span>
                </label>
                <select asp-for="Reason" id="reasonSelect" class="form-select" required>
                    <option value="">-- Chọn lý do --</option>
                    <option value="OUT_RETURN">Trả hàng lỗi về nhà sản xuất</option>
                    <option value="OUT_MANUAL">Xuất điều chỉnh tồn kho / Khác</option>
                </select>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <!-- Nhà cung cấp nhận hàng (chỉ hiện khi OUT_RETURN) -->
            <div class="mb-3" id="supplierGroup" style="display:none;">
                <label class="form-label fw-semibold">
                    <i class="fas fa-handshake me-1 text-secondary"></i> Nhà cung cấp nhận hàng trả
                </label>
                <select asp-for="SupplierId" asp-items="suppliers" class="form-select">
                    <option value="">-- Chọn nhà cung cấp --</option>
                </select>
                <div class="form-text text-muted">Chỉ điền khi xuất trả hàng lỗi về nhà sản xuất.</div>
            </div>

            <!-- Số lượng -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-sort-numeric-up me-1 text-secondary"></i> Số lượng xuất <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="Quantity" type="number" step="0.01" min="0.01"
                           max="@material?.CurrentQuantity" class="form-control" required
                           placeholder="Nhập số lượng cần xuất" />
                    <span class="input-group-text">@material?.Unit</span>
                </div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <!-- Đơn giá -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-dollar-sign me-1 text-secondary"></i> Đơn giá (VNĐ)
                </label>
                <input asp-for="UnitPrice" type="number" step="1" min="0"
                       class="form-control" placeholder="Đơn giá tham chiếu (tùy chọn)" />
                <div class="form-text text-muted">Giá trị tham chiếu; giá nhập gần nhất được gợi ý tự động.</div>
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            <!-- Ghi chú -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    <i class="fas fa-sticky-note me-1 text-secondary"></i> Ghi chú
                </label>
                <textarea asp-for="Note" class="form-control" rows="2"
                          placeholder="Mô tả thêm về lý do xuất kho..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="fas fa-sign-out-alt me-2"></i> Xác nhận xuất kho
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const reasonSelect   = document.getElementById('reasonSelect');
    const supplierGroup  = document.getElementById('supplierGroup');

    function toggleSupplier() {
        supplierGroup.style.display = reasonSelect.value === 'OUT_RETURN' ? '' : 'none';
    }

    reasonSelect.addEventListener('change', toggleSupplier);
    toggleSupplier(); // init
</script>
}