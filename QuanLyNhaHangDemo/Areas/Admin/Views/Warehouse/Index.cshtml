@model IEnumerable<QuanLyNhaHangDemo.Models.MaterialModel>

@{
    ViewData["Title"] = "Warehouse";
    var prices = ViewBag.LatestPriceByMaterial as Dictionary<int, decimal>;
}

<h2 class="mb-3">Danh sách nguyên liệu</h2>

<a asp-action="CreateMaterial" class="btn btn-primary mb-3">
    + Thêm nguyên liệu
</a>
<a asp-action="ImportHistory" class="btn btn-primary mb-3">
    <i class="fas fa-arrow-circle-down me-1"></i> Lịch sử nhập kho
</a>
<a asp-action="ExportHistory" class="btn btn-warning mb-3">
    <i class="fas fa-arrow-circle-up me-1"></i> Lịch sử xuất kho
</a>

<table class="table table-bordered table-hover" id="myTable">
    <thead class="table-dark">
        <tr>
            <th>Tên</th>
            <th>Nhà cung cấp</th>
            <th>Số lượng</th>
            <th>Đơn vị</th>
            <th>Giá nhập gần nhất</th>
            <th>Hạn sử dụng</th>
            <th width="250">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var price = prices != null && prices.ContainsKey(item.Id)
            ? prices[item.Id]
            : 0;

            <tr>
                <td>@item.Name</td>
                <td>@item.Supplier?.SupplierName</td>
                <td class="text-center fw-semibold">@item.CurrentQuantity.ToString("G29")</td>
                <td>@item.Unit</td>
                <td>@price.ToString("N0")</td>
                <td>
                    @if(item.ExpiryDate.HasValue)
                    {
                        var daysToExpire = (item.ExpiryDate.Value - DateTime.Now).TotalDays;
                        if (daysToExpire < 0)
                        {
                            <span class="badge bg-danger">Đã hết hạn</span>
                        }
                        else if (daysToExpire <= 7)
                        {
                            <span class="badge bg-warning text-dark">Sắp hết hạn (@Math.Ceiling(daysToExpire) ngày)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Còn @Math.Ceiling(daysToExpire) ngày</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Chưa có thông tin</span>
                    }
                </td>
                <td>
                    <a asp-action="EditMaterial" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>

                    <a asp-action="Import" asp-route-id="@item.Id" class="btn btn-success btn-sm">Nhập</a>

                    <a asp-action="Export" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xuất</a>
                </td>
            </tr>
        }
    </tbody>
</table>