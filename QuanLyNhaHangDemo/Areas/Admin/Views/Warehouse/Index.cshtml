@model IEnumerable<QuanLyNhaHangDemo.Models.MaterialModel>

@{
    ViewData["Title"] = "Warehouse";
    var prices = ViewBag.LatestPriceByMaterial as Dictionary<int, decimal>;
}

<style>
    /* Ép buộc DataTables/Bootstrap đổi màu toàn bộ ô (cả khung) của dòng */
    #myTable tr.expired-row td {
        background-color: #ffe6e6 !important; /* Đỏ nhạt */
        color: #b30000 !important;
    }
    #myTable tr.warning-row td {
        background-color: #fff8e6 !important; /* Vàng nhạt */
        color: #8a6d3b !important;
    }
</style>

<h2 class="mb-3">Danh sách nguyên liệu</h2>

<a asp-action="CreateMaterial" class="btn btn-primary mb-3">
    + Thêm nguyên liệu
</a>
<a asp-action="ImportHistory" class="btn btn-primary mb-3">
    <i class="fas fa-arrow-circle-down me-1"></i> Lịch sử nhập kho
</a>
<a asp-action="ExportHistory" class="btn btn-warning mb-3">
    <i class="fas fa-arrow-circle-up me-1"></i> Lịch sử xuất kho
</a>

<table class="table table-bordered table-hover" id="myTable">
    <thead class="table-dark">
        <tr>
            <th>Tên</th>
            <th>Nhà cung cấp</th>
            <th>Số lượng</th>
            <th>Đơn vị</th>
            <th>Giá nhập gần nhất</th>
            <th>Hạn sử dụng</th>
            <th width="250">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var price = prices != null && prices.ContainsKey(item.Id)
            ? prices[item.Id]
            : 0;

            var daysToExpire = item.ExpiryDate.HasValue ? (item.ExpiryDate.Value - DateTime.Now).TotalDays : (double?)null;
            
            var isExpired = daysToExpire.HasValue && daysToExpire.Value < 0;
            var isAboutToExpire = daysToExpire.HasValue && daysToExpire.Value >= 0 && daysToExpire.Value <= 7;
            var isLowStock = item.CurrentQuantity <= item.ReorderLevel;

            var rowClass = "";
            if (isExpired)
            {
                rowClass = "expired-row";
            }
            else if (isAboutToExpire || isLowStock)
            {
                rowClass = "warning-row";
            }

            <tr class="@rowClass">
                <td>@item.Name</td>
                <td>@item.Supplier?.SupplierName</td>
                <td class="text-center fw-semibold">
                    @item.CurrentQuantity.ToString("G29")
                    @if (isLowStock)
                    {
                        <br /><span class="badge bg-danger mt-1">Sắp hết (&lt;= @item.ReorderLevel.ToString("G29"))</span>
                    }
                </td>
                <td>@item.Unit</td>
                <td>@price.ToString("N0")</td>
                <td>
                    @if(daysToExpire.HasValue)
                    {
                        if (isExpired)
                        {
                            <span class="badge bg-danger">Đã hết hạn</span>
                        }
                        else if (isAboutToExpire)
                        {
                            <span class="badge bg-warning text-dark">Sắp hết hạn (@Math.Ceiling(daysToExpire.Value) ngày)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Còn @Math.Ceiling(daysToExpire.Value) ngày</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Chưa có thông tin</span>
                    }
                </td>
                <td>
                    <a asp-action="EditMaterial" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>

                    <a asp-action="Import" asp-route-id="@item.Id" class="btn btn-success btn-sm">Nhập</a>

                    <a asp-action="Export" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xuất</a>
                </td>
            </tr>
        }
    </tbody>
</table>