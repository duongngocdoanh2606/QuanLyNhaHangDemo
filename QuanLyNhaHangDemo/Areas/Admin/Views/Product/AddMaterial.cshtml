
@{
    ViewData["Title"] = "Định mức nguyên liệu";
    var product = ViewBag.Product as QuanLyNhaHangDemo.Models.ProductModel;
    var currentMaterials = ViewBag.CurrentMaterials as List<QuanLyNhaHangDemo.Models.ProductMaterialsModel>;
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">⚙️ Thiết lập định mức nguyên liệu cho món: <strong>@product.Name</strong></h4>
        </div>
        <div class="card-body">
            <form asp-action="AddMaterial" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@product.Id" />

                <div class="table-responsive">
                    <table class="table table-bordered" id="materialsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60%;">Tên nguyên liệu thô</th>
                                <th style="width: 30%;">Số lượng tiêu hao (cho 1 suất ăn)</th>
                                <th style="width: 10%; text-align: center;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (currentMaterials != null && currentMaterials.Any())
                            {
                                foreach (var item in currentMaterials)
                                {
                                    <tr>
                                        <td>
                                            <select name="materialIds" class="form-select" asp-items="ViewBag.AllMaterials" value="@item.MaterialId" required>
                                                <option value="">-- Chọn nguyên liệu --</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="quantities" class="form-control" step="0.01" value="@item.QuantityRequired" required />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-danger btn-sm btn-remove-row">❌ Xóa</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="emptyRowWarning">
                                    <td colspan="3" class="text-center text-muted">Món ăn này chưa được cấu hình định mức vật liệu thô. Hãy bấm nút thêm dòng bên dưới!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-success" id="btnAddRow">➕ Thêm nguyên liệu</button>
                </div>

                <hr />
                <div class="form-group">
                    <button type="submit" class="btn btn-primary px-4">💾 Lưu lại định mức</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div style="display:none;">
    <table id="rowTemplate">
        <tr>
            <td>
                <select name="materialIds" class="form-select" asp-items="ViewBag.AllMaterials" required>
                    <option value="">-- Chọn nguyên liệu --</option>
                </select>
            </td>
            <td>
                <input type="number" name="quantities" class="form-control" step="0.01" placeholder="Ví dụ: 0.15 (kg)" required />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-danger btn-sm btn-remove-row">❌ Xóa</button>
            </td>
        </tr>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tableBody = document.querySelector("#materialsTable tbody");
            const btnAddRow = document.getElementById("btnAddRow");
            const templateRow = document.querySelector("#rowTemplate tr");

            // 🔥 THÊM ĐOẠN NÀY: Duyệt qua tất cả các select hiện tại để hiển thị đúng nguyên liệu cũ
            document.querySelectorAll("#materialsTable tbody select").forEach(select => {
                const oldValue = select.getAttribute("value");
                if (oldValue) {
                    select.value = oldValue;
                }
            });

            // Xử lý sự kiện bấm nút Thêm dòng mới
            btnAddRow.addEventListener("click", function () {
                const emptyRow = document.getElementById("emptyRowWarning");
                if (emptyRow) emptyRow.remove(); // Xóa dòng thông báo trống nếu có

                const newRow = templateRow.cloneNode(true);
                tableBody.appendChild(newRow);
            });

            // Xử lý sự kiện xóa dòng trực tiếp (Dùng Event Delegation)
            tableBody.addEventListener("click", function (e) {
                if (e.target && e.target.classList.contains("btn-remove-row")) {
                    e.target.closest("tr").remove();
                }
            });
        });
    </script>
}