@model IEnumerable<ProductModel>

@{
    ViewData["title"] = "Product Listed";
}

<h3>List Products</h3>

<a asp-area="Admin" asp-action="Create" asp-controller="Product" class="btn btn-primary mb-3">
    Add Product
</a>

<table class="table table-bordered" id="myTable">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Sold</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
            <th>Category</th>
            <th>Modifier</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <!-- MAIN ROW -->
            <tr>
                <td>@item.Name</td>
                <td><b>@item.Sold</b></td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Price.ToString("N0") ₫</td>
                <td>
                    <img src="~/media/products/@item.Image" width="100" style="border-radius:6px;" />
                </td>
                <td>@item.Category?.Name</td>

                <!-- MODIFIER -->
                <td>
                    <button class="btn btn-sm btn-primary mb-1"
                            data-bs-toggle="modal" data-bs-target="#modalModifier_@item.Id">
                        Modifier ▼
                    </button>

                    <!-- Badge hiển thị -->
                    <div>
                        @foreach (var g in item.ProductModifierGroups)
                        {
                            <span class="badge bg-success">
                                @g.ModifierGroup.Name
                            </span>
                        }
                    </div>
                </td>

                <!-- ACTION -->
                <td>
                    <div class="d-flex flex-column gap-1">
                        <a asp-action="AddMaterial"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-info btn-sm text-white mb-1">
                            ⚙️ Recipe
                        </a>

                        <a asp-action="Edit"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-warning btn-sm mb-1">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-danger btn-sm confirmDeletion">
                            Delete
                        </a>
                    </div>
                </td>
            </tr>

        }
    </tbody>
</table>

@foreach (var item in Model)
{
    <!-- Modal cho Modifier của Product @item.Id -->
    <div class="modal fade" id="modalModifier_@item.Id" tabindex="-1" aria-labelledby="modalModifierLabel_@item.Id" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalModifierLabel_@item.Id">Cài đặt Modifier - @item.Name</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
             <div class="row">
                 @foreach (var group in ViewBag.AllModifierGroups)
                 {
                     var isChecked = item.ProductModifierGroups != null &&
                     item.ProductModifierGroups.Any(x => x.ModifierGroupId == group.Id);

                     <div class="col-md-3 mb-2">
                         <label style="cursor:pointer;">
                             <input type="checkbox"
                                    onchange="update(@item.Id, @group.Id, this.checked)"
                                    @(isChecked ? "checked" : "") />

                             <b>@group.Name</b>
                         </label>
                     </div>
                 }
             </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          </div>
        </div>
      </div>
    </div>
}

@section Scripts {
    <script>


        function update(productId, groupId, isChecked) {
            fetch('/Admin/Product/ToggleModifier', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    groupId: groupId,
                    isChecked: isChecked
                })
            })
            .then(() => {
                console.log("Updated!");
            })
            .catch(err => console.error(err));
        }
    </script>

    <style>
        .badge {
            margin: 2px;
            font-size: 12px;
        }


    </style>
}