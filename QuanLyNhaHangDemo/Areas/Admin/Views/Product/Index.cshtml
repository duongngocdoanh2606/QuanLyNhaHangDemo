@model IEnumerable<ProductModel>

@{
    ViewData["title"] = "Product Listed";
}

<h3>List Products</h3>

<a asp-area="Admin" asp-action="Create" asp-controller="Product" class="btn btn-primary mb-3">
    Add Product
</a>

<table class="table table-bordered" id="myTable">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Sold</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
            <th>Category</th>
            <th>Modifier</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <!-- MAIN ROW -->
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td><b>@item.Sold</b></td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Price</td>
                <td>
                    <img src="~/media/products/@item.Image" width="100" style="border-radius:6px;" />
                </td>
                <td>@item.Category?.Name</td>

                <!-- MODIFIER -->
                <td>
                    <button class="btn btn-sm btn-primary mb-1"
                            onclick="toggle(@item.Id)">
                        Modifier ▼
                    </button>

                    <!-- Badge hiển thị -->
                    <div>
                        @foreach (var g in item.ProductModifierGroups)
                        {
                            <span class="badge bg-success">
                                @g.ModifierGroup.Name
                            </span>
                        }
                    </div>
                </td>

                <!-- ACTION -->
                <td>
                    <div class="d-flex flex-column gap-1">
                        <a asp-action="AddMaterial"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-info btn-sm text-white mb-1">
                            ⚙️ Recipe
                        </a>

                        <a asp-action="Edit"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-warning btn-sm mb-1">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-controller="Product"
                           asp-route-Id="@item.Id"
                           class="btn btn-danger btn-sm confirmDeletion">
                            Delete
                        </a>
                    </div>
                </td>
            </tr>

            <!-- 🔥 EXPAND ROW -->
            <tr id="row_@item.Id" style="display:none; background:#f8f9fa;">
                <td colspan="9">

                    <div class="row">
                        @foreach (var group in ViewBag.AllModifierGroups)
                        {
                            var isChecked = item.ProductModifierGroups != null &&
                            item.ProductModifierGroups.Any(x => x.ModifierGroupId == group.Id);

                            <div class="col-md-3 mb-2">
                                <label style="cursor:pointer;">
                                    <input type="checkbox"
                                           onchange="update(@item.Id, @group.Id, this.checked)"
                                           @(isChecked ? "checked" : "") />

                                    <b>@group.Name</b>
                                </label>
                            </div>
                        }
                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function toggle(id) {
            let row = document.getElementById("row_" + id);

            if (!row) {
                console.error("Không tìm thấy row_" + id);
                return;
            }

            row.style.display = row.style.display === "none" ? "" : "none";
        }

        function update(productId, groupId, isChecked) {
            fetch('/Admin/Product/ToggleModifier', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    groupId: groupId,
                    isChecked: isChecked
                })
            })
            .then(() => {
                console.log("Updated!");
            })
            .catch(err => console.error(err));
        }
    </script>

    <style>
        .badge {
            margin: 2px;
            font-size: 12px;
        }

        tr[id^="row_"] {
            transition: all 0.2s ease;
        }
    </style>
}