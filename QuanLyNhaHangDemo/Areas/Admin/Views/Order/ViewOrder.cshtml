@model IEnumerable<OrderDetailsModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@using QuanLyNhaHangDemo.Helpers

@{
    ViewData["title"] = "Chi tiết đơn hàng";
    var canModify = ViewBag.CanModifyItems as bool? ?? false;
    decimal total = 0;
    decimal subtotal = 0;
    var order = Model.FirstOrDefault()?.Order;
    decimal vatAmount = order?.VATAmount ?? 0;
    decimal serviceAmount = order?.ServiceAmount ?? 0;
    decimal discountAmount = order?.DiscountAmount ?? 0;
    decimal grandTotal = order?.GrandTotal ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Chi tiết đơn hàng</h3>
    @if (Model.Any())
    {
        <span class="badge @ViewBag.OrderStatusClass fs-6">
            @ViewBag.OrderStatusLabel
        </span>
    }
</div>

@if (Model.Any())
{
    <a href="/Admin/Order/Invoice?ordercode=@Model.First().Order.OrderCode"
       class="btn btn-primary mb-3"
       target="_blank">
        <i class="fas fa-print"></i> In hóa đơn
    </a>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="detail_order">
        <thead>
            <tr>
                <th>Id</th>
                <th>Mã đơn</th>
                <th>Khách</th>
                <th>Món</th>
                <th>Đơn giá</th>
                <th>SL</th>
                <th>Thành tiền</th>
                <th>Trạng thái</th>
                @if (canModify)
                {
                    <th>Thao tác món</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    subtotal = item.Quantity * item.UnitPrice;
                    total += subtotal;

                    var canFire = canModify && item.Status != StatusProduct.Cancelled
                    && item.Status != StatusProduct.Done && item.Status != StatusProduct.Served;

                    var canRemake = canModify && (item.Status == StatusProduct.Done || item.Status == StatusProduct.Served);

                    // Cho phép hủy khi món chưa nấu xong hoặc đang chờ
                    var canCancel = canModify && (item.Status == StatusProduct.Pending || item.Status == StatusProduct.PreparingIngredient);

                    <tr class="@(item.IsFired && item.Status == StatusProduct.Cooking ? "table-warning" : "")">
                        <td>
                            <input type="hidden" value="@item.Order.OrderCode" class="getOrderCode" />
                            @item.Id
                        </td>
                        <td>@item.Order.OrderCode</td>
                        <td>@item.Order.GuestName</td>
                        <td>
                            <strong>@item.Product.Name</strong>
                            @if (item.FireCount > 0)
                            {
                                <span class="badge bg-danger ms-1">Làm lại ×@item.FireCount</span>
                            }
                            @if (item.IsFired && (item.Status == StatusProduct.Pending || item.Status == StatusProduct.Cooking))
                            {
                                <span class="badge bg-danger ms-1"><i class="fas fa-fire"></i> FIRE</span>
                            }

                            @if (item.OrderDetailModifiers != null && item.OrderDetailModifiers.Any())
                            {
                                <ul class="mb-0 ps-3 mt-1" style="font-size: 0.85em; color: #555;">
                                    @foreach(var mod in item.OrderDetailModifiers)
                                    {
                                        <li>@mod.Modifier?.Name (+@mod.ModifierPrice.ToString("#,##0"))</li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <div class="text-danger mt-1" style="font-size: 0.85em;"><i class="fas fa-comment-dots"></i> @item.Note</div>
                            }
                        </td>
                        <td>@item.UnitPrice.ToString("#,##0 VNĐ")</td>
                        <td>@item.Quantity</td>
                        <td>@subtotal.ToString("#,##0 VNĐ")</td>
                        <td>
                            <span class="badge @OrderStatusHelper.GetItemStatusBadgeClass(item.Status)">
                                @OrderStatusHelper.GetItemStatusLabel(item.Status)
                            </span>
                            @if (!item.IsFired && item.Status == StatusProduct.Pending)
                            {
                                <br />
                    
                                <small class="text-muted">Chưa gửi bếp (Hold)</small>
                            }
                        </td>
                        @if (canModify)
                        {
                            <td class="text-nowrap">
                                @if (canFire)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-fire-item"
                                            data-id="@item.Id"
                                            data-remake="false"
                                            title="Ưu tiên nấu / gửi xuống bếp">
                                        <i class="fas fa-fire"></i> Fire
                                    </button>
                                }

                                @if (canRemake)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-warning btn-fire-item"
                                            data-id="@item.Id"
                                            data-remake="true"
                                            title="Làm lại món cho khách">
                                        <i class="fas fa-redo"></i> Làm lại
                                    </button>
                                }

                                @if (canCancel)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning btn-cancel-item ms-1"
                                            data-id="@item.Id"
                                            title="Hủy món này khỏi hóa đơn (đánh dấu hủy)">
                                        <i class="fas fa-ban"></i> Hủy
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-delete-item ms-1"
                                            data-id="@item.Id"
                                            title="Xóa món này khỏi hệ thống">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }

            }
        </tbody>
        @if (Model.Any())
        {
            <tfoot>
                <tr>
                    <td colspan="6"></td>
                    <td><strong>Tổng tiền hàng:</strong></td>
                    <td colspan="@(canModify ? 2 : 1)">
                        <strong>@total.ToString("#,##0 VNĐ")</strong>
                    </td>
                </tr>
                @if (serviceAmount > 0)
                {
                    <tr>
                        <td colspan="6"></td>
                        <td>Phí phục vụ (@((order?.ServiceRate * 100)?.ToString("0"))%):</td>
                        <td colspan="@(canModify ? 2 : 1)">@serviceAmount.ToString("#,##0 VNĐ")</td>
                    </tr>
                }
                @if (vatAmount > 0)
                {
                    <tr>
                        <td colspan="6"></td>
                        <td>Thuế VAT (@((order?.VATRate * 100)?.ToString("0"))%):</td>
                        <td colspan="@(canModify ? 2 : 1)">@vatAmount.ToString("#,##0 VNĐ")</td>
                    </tr>
                }
                @if (discountAmount > 0)
                {
                    <tr>
                        <td colspan="6"></td>
                        <td>Giảm giá:</td>
                        <td colspan="@(canModify ? 2 : 1)" class="text-danger">-@discountAmount.ToString("#,##0 VNĐ")</td>
                    </tr>
                }
                <tr>
                    <td colspan="6"></td>
                    <td><strong class="text-success fs-5">TỔNG THANH TOÁN:</strong></td>
                    <td colspan="@(canModify ? 2 : 1)">
                        <strong class="text-success fs-5">@grandTotal.ToString("#,##0 VNĐ")</strong>
                    </td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@section Scripts
{
    <script>
        new DataTable('#detail_order', {
            layout: {
                topStart: {
                    buttons: ['pdf', 'print']
                }
            }
        });
    </script>
    <script>
        $(document).ready(function () {

            // XỬ LÝ SỰ KIỆN NÚT FIRE / LÀM LẠI
            $(document).on('click', '.btn-fire-item', function () {
                var btn = $(this);
                var id = btn.data('id');
                var remake = btn.data('remake') === true || btn.data('remake') === 'true';

                $.post('@Url.Action("FireItem", "Order", new { area = "Admin" })', {
                    orderDetailId: id,
                    remake: remake
                }).done(function (result) {
                    if (result.success) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: result.message })
                            .then(function () { location.reload(); });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                    }
                }).fail(function () {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không gọi được server' });
                });
            });

            // XỬ LÝ SỰ KIỆN NÚT HỦY MÓN
            $(document).on('click', '.btn-cancel-item', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Xác nhận hủy món?',
                    text: "Món ăn này sẽ bị hủy (đánh dấu hủy) khỏi danh sách chi tiết!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f0ad4e',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Đồng ý hủy',
                    cancelButtonText: 'Bỏ qua'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("CancelItem", "Order", new { area = "Admin" })', {
                            orderDetailId: id
                        }).done(function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: ' Đã hủy món', text: res.message })
                                    .then(function () { location.reload(); });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Thất bại', text: res.message });
                            }
                        }).fail(function () {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể kết nối đến máy chủ' });
                        });
                    }
                });
            });

            // XỬ LÝ SỰ KIỆN NÚT XÓA MÓN
            $(document).on('click', '.btn-delete-item', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Xác nhận xóa món?',
                    text: "Món ăn này sẽ bị XÓA HOÀN TOÀN khỏi hóa đơn!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Bỏ qua'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("DeleteItem", "Order", new { area = "Admin" })', {
                            orderDetailId: id
                        }).done(function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: ' Đã xóa món', text: res.message })
                                    .then(function () { location.reload(); });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Thất bại', text: res.message });
                            }
                        }).fail(function () {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể kết nối đến máy chủ' });
                        });
                    }
                });
            });

        });
    </script>
}