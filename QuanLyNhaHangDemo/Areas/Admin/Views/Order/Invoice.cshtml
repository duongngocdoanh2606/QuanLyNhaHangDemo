@model IEnumerable<QuanLyNhaHangDemo.Models.OrderDetailsModel>

@{
    Layout = null;

    var firstItem = Model.FirstOrDefault();

    var orderCode = firstItem?.Order?.OrderCode ?? "N/A";

    var buyer = firstItem?.Order?.GuestName ?? "Khách lẻ";

    decimal total = ViewBag.Total ?? 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Hóa đơn - @orderCode</title>

    <style>

        body {
            font-family: Arial, Helvetica, sans-serif;
            padding: 20px;
            color: #222;
        }

        .invoice-container {
            max-width: 800px;
            margin: auto;
        }

        .top-actions {
            margin-bottom: 20px;
        }

        .print-btn,
        .pdf-btn {
            padding: 10px 16px;
            border: none;
            color: white;
            cursor: pointer;
            margin-right: 10px;
            border-radius: 5px;
        }

        .print-btn {
            background: #0d6efd;
        }

        .pdf-btn {
            background: #198754;
        }

        h2, h4 {
            margin: 6px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 10px;
        }

        th {
            background: #f5f5f5;
        }

        .text-right {
            text-align: right;
        }

        .total-line {
            font-weight: bold;
            font-size: 15px;
        }

        @@media print {

            .top-actions {
                display: none;
            }

            body {
                padding: 0;
            }
        }

    </style>
</head>

<body>

    <div class="invoice-container" id="invoice">

        <div class="top-actions">

            <button class="print-btn"
                    onclick="window.print()">
                In hóa đơn
            </button>

            <button class="pdf-btn"
                    onclick="downloadPDF()">
                Xuất PDF
            </button>

        </div>

        <h2>HÓA ĐƠN BÁN HÀNG</h2>

        <h4>Mã đơn hàng: @orderCode</h4>

        <h4>Khách hàng: @buyer</h4>

        <h4>@ViewBag.TableInfo</h4>

        <h4>
            Ngày:
            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </h4>

        <table>

            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    var lineTotal = item.UnitPrice * item.Quantity;

                    <tr>

                        <td>
                            @item.Product.Name
                        </td>

                        <td class="text-right">
                            @item.UnitPrice.ToString("N0") đ
                        </td>

                        <td class="text-right">
                            @item.Quantity
                        </td>

                        <td class="text-right">
                            @lineTotal.ToString("N0") đ
                        </td>

                    </tr>
                }

                <tr>

                    <td colspan="3"
                        class="text-right total-line">
                        Tổng tiền hàng:
                    </td>

                    <td class="text-right total-line">
                        @total.ToString("N0") đ
                    </td>

                </tr>

                <tr>

                    <td colspan="3"
                        class="text-right total-line">
                        Phí ship:
                    </td>

                 

                </tr>

                <tr>

                    <td colspan="3"
                        class="text-right total-line">
                        Tổng thanh toán:
                    </td>

                    <td class="text-right total-line">
                        @((total).ToString("N0")) đ
                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>

    async function downloadPDF() {

        const { jsPDF } = window.jspdf;

        const pdf = new jsPDF('p', 'mm', 'a4');

        const invoice = document.getElementById('invoice');

        const canvas = await html2canvas(invoice);

        const imgData = canvas.toDataURL('image/png');

        const imgWidth = 210;

        const pageHeight = 297;

        const imgHeight =
            canvas.height * imgWidth / canvas.width;

        let heightLeft = imgHeight;

        let position = 0;

        pdf.addImage(
            imgData,
            'PNG',
            0,
            position,
            imgWidth,
            imgHeight
        );

        heightLeft -= pageHeight;

        while (heightLeft > 0) {

            position = heightLeft - imgHeight;

            pdf.addPage();

            pdf.addImage(
                imgData,
                'PNG',
                0,
                position,
                imgWidth,
                imgHeight
            );

            heightLeft -= pageHeight;
        }

        pdf.save(`HoaDon_${'@orderCode'}.pdf`);
    }

</script>