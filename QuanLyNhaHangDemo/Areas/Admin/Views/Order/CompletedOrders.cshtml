@model IEnumerable<QuanLyNhaHangDemo.Models.CompletedOrderViewModel>

@{
    ViewData["Title"] = "Đơn hàng hoàn thành";
    decimal totalRevenue        = ViewBag.TotalRevenue ?? 0;
    decimal totalGrand          = ViewBag.TotalRevenueWithCoupon ?? 0;
    decimal totalVAT            = ViewBag.TotalVAT ?? 0;
    decimal totalService        = ViewBag.TotalService ?? 0;
    decimal totalDiscount       = ViewBag.TotalDiscount ?? 0;
}

<h3>Đơn hàng hoàn thành</h3>

<form method="get" class="row g-3 mb-3">
    <div class="col-auto">
        <label class="form-label">Từ ngày</label>
        <input type="date" name="from"
               class="form-control"
               value="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="col-auto">
        <label class="form-label">Đến ngày</label>
        <input type="date" name="to"
               class="form-control"
               value="@(ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="col-auto" style="margin-top:32px">
        <button type="submit" class="btn btn-primary">Lọc</button>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Order Code</th>
            <th>User Name</th>
            <th>Ngày tạo</th>
            <th>Doanh thu (món gốc)</th>
            <th>Thuế VAT</th>
            <th>Phí DV</th>
            <th>Mã Coupon</th>
            <th>Tiền giảm giá</th>
            <th>Thành tiền (Grand Total)</th>
            <th>Thanh toán</th>
            <th>In hóa đơn</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.OrderCode</td>
                <td>@o.UserName</td>
                <td>@o.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@o.OrderRevenue.ToString("N0") ₫</td>
                <td>@o.VATAmount.ToString("N0") ₫</td>
                <td>@o.ServiceAmount.ToString("N0") ₫</td>

                <td><span class="badge bg-secondary text-white">@o.CouponCode</span></td>

                <td class="text-danger">-@o.CouponDiscount.ToString("N0") ₫</td>

                <td class="fw-bold text-success">@o.TotalWithCoupon.ToString("N0") ₫</td>

                <td>
                    <span class="badge @(o.Method == PaymentMethod.VNPay ? "bg-primary" : "bg-success")">
                        <i class="@o.PaymentMethodIcon me-1"></i>@o.PaymentMethodLabel
                    </span>
                </td>

                <td>
                    <a class="btn btn-secondary btn-sm"
                       href="/Admin/Order/Invoice?ordercode=@o.OrderCode"
                       target="_blank">
                        In hóa đơn
                    </a>
                    <a asp-action="Delete"
                       asp-controller="Order"
                       asp-route-ordercode="@o.OrderCode"
                       class="btn btn-danger btn-sm confirmDeletion">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3 p-3 bg-light border rounded">
    <h5>BÁO CÁO THU NHẬP</h5>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <p class="mb-1"><strong>Doanh thu món gốc (SubTotal):</strong></p>
            <h6 class="text-secondary">@totalRevenue.ToString("N0") ₫</h6>
        </div>
        <div class="col-md-4">
            <p class="mb-1"><strong>Thuế VAT:</strong></p>
            <h6 class="text-warning">+@totalVAT.ToString("N0") ₫</h6>
        </div>
        <div class="col-md-4">
            <p class="mb-1"><strong>Phí dịch vụ:</strong></p>
            <h6 class="text-warning">+@totalService.ToString("N0") ₫</h6>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-4">
            <p class="mb-1"><strong>Tổng giảm giá (Coupon):</strong></p>
            <h6 class="text-danger">-@totalDiscount.ToString("N0") ₫</h6>
        </div>
        <div class="col-md-8">
            <p class="mb-1"><strong>Tổng doanh thu thực tế (GrandTotal):</strong></p>
            <h5 class="text-success">@totalGrand.ToString("N0") ₫</h5>
        </div>
    </div>
</div>