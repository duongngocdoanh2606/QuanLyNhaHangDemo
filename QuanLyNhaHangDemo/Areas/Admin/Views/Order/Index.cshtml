@model IEnumerable<OrderModel>
@{
    ViewData["title"] = "Orders Listed";
}

<h3>List Order</h3>
<a asp-action="CompletedOrders"
   asp-controller="Order"
   class="btn btn-success mb-3">
    Xem đơn hoàn thành & doanh thu
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Order Code</th>
            <th>User Name</th>
            <th>Order Date</th>
            <th>Timer</th>
            <th>Order Status</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @{
            int stt = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@(stt++)</td>
                <td class="fw-bold">@item.OrderCode</td>
                <td>@item.GuestName</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="timer fw-bold"
                          data-start="@item.CreatedDate.ToString("O")">
                    </span>
                </td>
                <td>
                    @switch (item.Status)
                    {
                        case OrderModel.OrderStatus.Pending:
                            <span class="badge bg-secondary">Chờ bếp</span>
                            break;
                        case OrderModel.OrderStatus.Serving:
                            <span class="badge bg-primary">Đang phục vụ</span>
                            break;
                        case OrderModel.OrderStatus.Paid:
                            <span class="badge bg-success">Đã thanh toán</span>
                            break;
                        case OrderModel.OrderStatus.Completed:
                            <span class="badge bg-info">Hoàn thành</span>
                            break;
                        case OrderModel.OrderStatus.Cancelled:
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Delete"
                       asp-controller="Order"
                       asp-route-ordercode="@item.OrderCode"
                       class="btn btn-danger btn-sm confirmDeletion">
                        Delete
                    </a>

                    @if (item.Status != OrderModel.OrderStatus.Cancelled && item.Status != OrderModel.OrderStatus.Completed)
                    {
                        <a asp-action="ViewOrder"
                           asp-controller="Order"
                           asp-route-ordercode="@item.OrderCode"
                           class="btn btn-warning btn-sm">
                            View Order
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        setInterval(() => {
            document.querySelectorAll('.timer').forEach(el => {
                const start = new Date(el.dataset.start);
                const now = new Date();
                const diff = Math.floor((now - start) / 1000);

                if (diff < 0) return; // Tránh hiển thị số âm nếu thời gian server lệch nhẹ

                const m = Math.floor(diff / 60);
                const s = diff % 60;

                el.innerText = `⏱️ ${m}p ${s}s`;

                if (m >= 20) el.style.color = "red";
                else if (m >= 10) el.style.color = "orange";
            });
        }, 1000);
    </script>
}