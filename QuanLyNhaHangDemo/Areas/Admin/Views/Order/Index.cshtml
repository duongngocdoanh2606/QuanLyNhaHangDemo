@model IEnumerable<OrderModel>
@{
    ViewData["title"] = "Orders Listed";
}

<h3>List Order</h3>
<a asp-action="CompletedOrders"
   asp-controller="Order"
   class="btn btn-success mb-3">
    Xem đơn hoàn thành & doanh thu
</a>

<table class="table table-bordered table-striped" id="myTable">
    <thead>
        <tr>
            <th>Order Code</th>
            <th>User Name</th>
            <th>Order Date</th>
            <th>Timer</th>
            <th>Order Status</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @{
            int stt = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.OrderCode</td>
                <td>@item.GuestName</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="timer fw-bold"
                          data-start="@item.CreatedDate.ToString("O")">
                    </span>
                </td>
                <td>
                    @if (!item.IsConfirmed)
                    {
                        <span class="badge bg-warning text-dark"><i class="fa fa-bell"></i> Chờ xác nhận</span>
                    }
                    else
                    {
                        switch (item.Status)
                        {
                            case OrderModel.OrderStatus.Pending:
                                <span class="badge bg-secondary">Chờ bếp</span>
                                break;
                            case OrderModel.OrderStatus.Serving:
                                <span class="badge bg-primary">Đang phục vụ</span>
                                break;
                            case OrderModel.OrderStatus.Paid:
                                <span class="badge bg-success">Đã thanh toán</span>
                                break;
                            case OrderModel.OrderStatus.Completed:
                                <span class="badge bg-info">Hoàn thành</span>
                                break;
                            case OrderModel.OrderStatus.Cancelled:
                                <span class="badge bg-danger">Đã hủy</span>
                                break;
                        }
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Delete"
                       asp-controller="Order"
                       asp-route-ordercode="@item.OrderCode"
                       class="btn btn-danger btn-sm confirmDeletion">
                        Delete
                    </a>

                    @if (!item.IsConfirmed && item.Status != OrderModel.OrderStatus.Cancelled && item.Status != OrderModel.OrderStatus.Completed)
                    {
                        <button class="btn btn-info btn-sm btn-confirm-order" data-order-id="@item.Id">Xác nhận đơn</button>
                    }

                    @if (item.Status != OrderModel.OrderStatus.Cancelled && item.Status != OrderModel.OrderStatus.Completed)
                    {
                        <a asp-action="ViewOrder"
                           asp-controller="Order"
                           asp-route-ordercode="@item.OrderCode"
                           class="btn btn-warning btn-sm">
                            View Order
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        setInterval(() => {
            document.querySelectorAll('.timer').forEach(el => {
                const start = new Date(el.dataset.start);
                const now = new Date();
                const diff = Math.floor((now - start) / 1000);

                if (diff < 0) return; // Tránh hiển thị số âm nếu thời gian server lệch nhẹ

                const m = Math.floor(diff / 60);
                const s = diff % 60;

                el.innerText = `⏱️ ${m}p ${s}s`;

                if (m >= 20) el.style.color = "red";
                else if (m >= 10) el.style.color = "orange";
            });
        }, 1000);

        // Xử lý nút Xác nhận đơn
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-confirm-order')) {
                const btn = e.target;
                const orderId = btn.getAttribute('data-order-id');
                
                if(confirm('Bạn có chắc muốn xác nhận đơn này? Bếp sẽ bắt đầu làm món.')) {
                    btn.disabled = true;
                    btn.innerText = "Đang xử lý...";
                    
                    fetch(`/api/orders/${orderId}/confirm`, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(res => res.json().then(data => ({ status: res.status, body: data })))
                    .then(res => {
                        if (res.status === 200) {
                            alert(res.body.message);
                            location.reload(); // Tải lại trang sau khi xác nhận thành công
                        } else {
                            alert(res.body.message || "Có lỗi xảy ra");
                            btn.disabled = false;
                            btn.innerText = "Xác nhận đơn";
                        }
                    })
                    .catch(err => {
                        alert("Lỗi kết nối mạng");
                        console.error(err);
                        btn.disabled = false;
                        btn.innerText = "Xác nhận đơn";
                    });
                }
            }
        });
    </script>
}