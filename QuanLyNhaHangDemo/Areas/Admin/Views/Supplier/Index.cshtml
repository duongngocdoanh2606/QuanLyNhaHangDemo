@model IEnumerable<QuanLyNhaHangDemo.Models.SupplierModel>

@{
    ViewData["Title"] = "Danh sách nhà cung cấp";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách nhà cung cấp</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Thêm mới
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-bordered table-hover" id="myTable">
    <thead class="table-dark">
        <tr>
            <th>Tên nhà cung cấp</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th>Danh mục NCC</th>
            <th>Trạng thái</th>
            <th style="width:130px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @{int stt = 1;}
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SupplierName</td>
                <td>@item.SupplierEmail</td>
                <td>@item.SupplierAddress</td>
                <td>@item.SupplierCategory?.Name</td>
                <td>
                    @if (item.Status == QuanLyNhaHangDemo.Models.SupplierStatus.Active)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
