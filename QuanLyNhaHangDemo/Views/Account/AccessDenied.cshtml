@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Từ chối truy cập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .error-card { max-width: 450px; background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); text-align: center; border-top: 5px solid #dc3545; }
        .error-card i { font-size: 60px; color: #dc3545; margin-bottom: 20px; }
        .error-card h3 { font-weight: bold; color: #343a40; margin-bottom: 10px; }
        .error-card p { color: #6c757d; margin-bottom: 25px; }
        .btn-custom { background: #0d6efd; color: white; border-radius: 50px; padding: 10px 25px; text-decoration: none; font-weight: 500; transition: all 0.3s; }
        .btn-custom:hover { background: #0b5ed7; color: white; transform: translateY(-2px); }
    </style>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="error-card">
        <i class="fas fa-lock"></i>
        <h3>Truy Cập Bị Từ Chối</h3>
        <p>Xin lỗi, tài khoản của bạn không có đủ quyền để truy cập vào chức năng hoặc trang này. Vui lòng liên hệ quản trị viên nếu bạn nghĩ đây là sự nhầm lẫn.</p>
        <a href="javascript:history.back()" class="btn-custom me-2"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
        <a href="/Account/Logout" class="btn-custom bg-danger border-danger"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a>
    </div>
</body>
</html>
